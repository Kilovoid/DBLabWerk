<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SQLWerk.ViewModels"
        x:Class="SQLWerk.Views.ExhibitEditWindow"
        x:DataType="vm:ExhibitEditViewModel"
        Width="560" Height="720"
        WindowStartupLocation="CenterOwner"
        Title="{Binding Title}">
    <ScrollViewer>
        <StackPanel Margin="16" Spacing="6">
            <TextBlock Text="Код ВУЗа *"/>
            <ComboBox ItemsSource="{x:Static vm:ExhibitEditViewModel.VuzCodes}"
                      SelectedItem="{Binding Codvuz}"
                      HorizontalAlignment="Stretch"/>

            <TextBlock Text="Признак формы *"/>
            <ComboBox ItemsSource="{x:Static vm:ExhibitEditViewModel.TypeOptions}"
                      SelectedItem="{Binding Type}"
                      HorizontalAlignment="Stretch"/>

            <TextBlock Text="Регистрационный номер *"/>
            <TextBox Text="{Binding Regnumber}"/>

            <TextBlock Text="Наименование проекта *"/>
            <TextBox Text="{Binding Subject}"/>

            <TextBlock Text="Коды ГРНТИ * (до 5). Рубрика — 2 цифры, подрубрика — XX или XX.XX"/>
            <ItemsControl ItemsSource="{Binding GrntiEntries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:GrntiEntryVM">
                        <Grid ColumnDefinitions="*,8,*" Margin="0,0,0,4">
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{x:Static vm:ExhibitEditViewModel.GrntiRubrics}"
                                      SelectedItem="{Binding Rubric}"
                                      HorizontalAlignment="Stretch"
                                      PlaceholderText="Рубрика"/>
                            <MaskedTextBox Grid.Column="2"
                                Mask="00\.99"
                                Text="{Binding Sub, Mode=TwoWay}"
                                HorizontalAlignment="Stretch"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Руководитель *"/>
            <TextBox Text="{Binding Bossname}"/>

            <TextBlock Text="Должность/степень руководителя *"/>
            <TextBox Text="{Binding Bosstitle}"/>

            <TextBlock Text="Наличие экспоната *"/>
            <ComboBox ItemsSource="{x:Static vm:ExhibitEditViewModel.ExhibitOptions}"
                      SelectedItem="{Binding Exhitype}"
                      HorizontalAlignment="Stretch"/>

            <TextBlock Text="Выставки"/>
            <TextBox Text="{Binding Vystavki}"/>

            <TextBlock Text="Название экспоната"/>
            <TextBox Text="{Binding Exponat}"/>

            <TextBlock Text="{Binding Error}" Foreground="Red" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Сохранить" Command="{Binding SaveCommand}"/>
                <Button Content="Отмена"    Command="{Binding CancelCommand}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
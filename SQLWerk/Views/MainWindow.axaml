<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SQLWerk.ViewModels"
        xmlns:views="using:SQLWerk.Views"
        xmlns:models="using:SQLWerk.Models"
        x:Class="SQLWerk.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1080" Height="600"
        Title="Выставки МО">
	<DockPanel>
		<Menu DockPanel.Dock="Top">
			<MenuItem Header="Таблицы">
				<MenuItem Header="Выставки"
                          Command="{Binding SelectExhibitsCommand}" />
				<MenuItem Header="ВУЗы"
                          Command="{Binding SelectVuzCommand}" />
				<MenuItem Header="ГРНТИ"
                          Command="{Binding SelectGrntiCommand}" />
				<Separator />
				<MenuItem Header="Вся информация"
                          Command="{Binding SelectFullCommand}" />
			</MenuItem>

			<MenuItem Header="Загрузка данных">
				<MenuItem Header="Выбрать файлы Excel"
                          Command="{Binding LoadCommand}" />
			</MenuItem>
            <MenuItem Header="Группы НИР" Command="{Binding ShowNirGroupCommand}"/>
		</Menu>

		<StackPanel DockPanel.Dock="Top"
            Margin="12,8"
            IsVisible="{Binding !ShowErrorScreen}">

		<StackPanel.Styles>
			<Style Selector="TextBlock">
				<Setter Property="FontSize" Value="20"/>
				<Setter Property="FontWeight" Value="SemiBold"/>
			</Style>
		</StackPanel.Styles>

		<TextBlock Text="Выставки"
               IsVisible="{Binding ShowExhibits}"/>

		<TextBlock Text="ВУЗы"
               IsVisible="{Binding ShowVuz}"/>

		<TextBlock Text="ГРНТИ"
               IsVisible="{Binding ShowGrnti}"/>

		<TextBlock Text="Вся информация"
               IsVisible="{Binding ShowAll}"/>

		<TextBlock Text="Группы НИР"
               IsVisible="{Binding ShowNirGroups}"/>
        <Border Height="1" Background="#D6DCE2" Margin="0,8,0,0"
                IsVisible="{Binding ShowNirGroups}"/>
		</StackPanel>



		<Border DockPanel.Dock="Bottom" IsVisible="{Binding !ShowNirGroups}"
                Background="#EFEFEF"
                Padding="8,4"
                BorderBrush="#CCCCCC"
                BorderThickness="0,1,0,0">
			<Grid ColumnDefinitions="*,Auto,Auto">
				<TextBlock Grid.Column="0"
                           Text="{Binding Status}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

				<TextBlock Grid.Column="1"
                           Text="{Binding WarningCount, StringFormat='Предупреждений: {0}'}"
                           VerticalAlignment="Center"
                           Margin="12,0,12,0" />

				<Button Grid.Column="2"
                        Content="Журнал"
                        VerticalAlignment="Center"
                        IsEnabled="{Binding !ShowErrorScreen}"
                        Classes.blink="{Binding IsBlinking}"
                        Command="{Binding ShowLogCommand}" />
			</Grid>
		</Border>

		<Grid>
			<Grid IsVisible="{Binding !ShowErrorScreen}">
				<Grid IsVisible="{Binding ShowExhibits}" RowDefinitions="Auto,*">
					<StackPanel Grid.Row="0" Orientation="Horizontal"
                                Spacing="8" Margin="8,8,8,8">
						<Button Content="Добавить"  Command="{Binding AddExhibitCommand}"/>
						<Button Content="Изменить"
                                Command="{Binding EditExhibitCommand}"/>
						<Button Content="Удалить"
                                Command="{Binding DeleteExhibitCommand}"/>
                    </StackPanel>

					<DataGrid x:Name="ExhibitsGrid" SelectionMode="Extended"
                              SelectionChanged="OnGridSelectionChanged" Grid.Row="1"
                              ItemsSource="{Binding Exhibits}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True">
						<DataGrid.ContextMenu>
							<ContextMenu>
								<MenuItem Header="Изменить"
										  Command="{Binding EditExhibitCommand}"/>
								<MenuItem Header="Удалить"
										  Command="{Binding DeleteExhibitCommand}"/>
							    <Separator/>
                                <MenuItem Header="Добавить в группу НИР..."
                                          Command="{Binding AddSelectedExhibitsToNirGroupCommand}"/>
                            </ContextMenu>
						</DataGrid.ContextMenu>
						<DataGrid.Columns>
							<DataGridTextColumn Header="Код ВУЗа" Binding="{Binding Codvuz}" />
							<DataGridTextColumn Header="Признак формы" Binding="{Binding Type}" />
							<DataGridTextColumn Header="Регистрационный номер" Binding="{Binding Regnumber}" />
							<DataGridTextColumn Header="Наименование проекта" Binding="{Binding Subject}" />
							<DataGridTextColumn Header="Код ГРНТИ" Binding="{Binding Grnti}" />
							<DataGridTextColumn Header="Руководитель" Binding="{Binding Bossname}" />
							<DataGridTextColumn Header="Должность/научная степень руководителя" Binding="{Binding Bosstitle}" />
							<DataGridTextColumn Header="Наличие экспоната" Binding="{Binding Exhitype}" />
							<DataGridTextColumn Header="Выставки" Binding="{Binding Vystavki}" />
							<DataGridTextColumn Header="Название экспоната" Binding="{Binding Exponat}" />
						</DataGrid.Columns>
					</DataGrid>
				</Grid>

				<Grid IsVisible="{Binding ShowVuz}" RowDefinitions="Auto,*">
					<StackPanel Grid.Row="0" Orientation="Horizontal"
                                Spacing="8" Margin="8,8,8,8">
						<Button Content="Добавить"  Command="{Binding AddVuzCommand}"/>
						<Button Content="Изменить"
                                Command="{Binding EditVuzCommand}"/>
						<Button Content="Удалить"
                                Command="{Binding DeleteVuzCommand}"/>
					</StackPanel>

					<DataGrid x:Name="VuzGrid" SelectionMode="Extended"
                              SelectionChanged="OnGridSelectionChanged" Grid.Row="1"
                              ItemsSource="{Binding Vuzes}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True">
						<DataGrid.ContextMenu>
							<ContextMenu>
								<MenuItem Header="Изменить"
										  Command="{Binding EditVuzCommand}"/>
								<MenuItem Header="Удалить"
										  Command="{Binding DeleteVuzCommand}"/>
							</ContextMenu>
						</DataGrid.ContextMenu>
						<DataGrid.Columns>
							<DataGridTextColumn Header="Код ВУЗа" Binding="{Binding Codvuz}" />
							<DataGridTextColumn Header="Наименование ВУЗа" Binding="{Binding Z1}" />
							<DataGridTextColumn Header="Полное наименование" Binding="{Binding Z1Full}" />
							<DataGridTextColumn Header="Краткое наименование" Binding="{Binding Z2}" />
							<DataGridTextColumn Header="Федеральный округ" Binding="{Binding Region}" />
							<DataGridTextColumn Header="Город" Binding="{Binding City}" />
							<DataGridTextColumn Header="Тип учреждения" Binding="{Binding Status}" />
							<DataGridTextColumn Header="Код региона" Binding="{Binding Obl}" />
							<DataGridTextColumn Header="Регион" Binding="{Binding OblName}" />
							<DataGridTextColumn Header="Статус" Binding="{Binding GrVed}" />
							<DataGridTextColumn Header="Специализация" Binding="{Binding Prof}" />
						</DataGrid.Columns>
					</DataGrid>
				</Grid>

				<Grid IsVisible="{Binding ShowGrnti}" RowDefinitions="Auto,*">
					<StackPanel Grid.Row="0" Orientation="Horizontal"
                                Spacing="8" Margin="8,8,8,8">
						<Button Content="Добавить"  Command="{Binding AddGrntiCommand}"/>
						<Button Content="Изменить"
                                Command="{Binding EditGrntiCommand}"/>
						<Button Content="Удалить"
                                Command="{Binding DeleteGrntiCommand}"/>
					</StackPanel>

					<DataGrid x:Name="GrntiGrid" SelectionMode="Extended"
                              SelectionChanged="OnGridSelectionChanged"
                              Grid.Row="1"
                              ItemsSource="{Binding Grnti}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True">
						<DataGrid.ContextMenu>
							<ContextMenu>
								<MenuItem Header="Изменить"
										  Command="{Binding EditGrntiCommand}"/>
								<MenuItem Header="Удалить"
										  Command="{Binding DeleteGrntiCommand}"/>
							</ContextMenu>
						</DataGrid.ContextMenu>
						<DataGrid.Columns>
							<DataGridTextColumn Header="Код рубрики" Binding="{Binding Codrub}"/>
							<DataGridTextColumn Header="Наименование рубрики" Binding="{Binding Rubrika}"/>
						</DataGrid.Columns>
					</DataGrid>
				</Grid>

				<Grid IsVisible="{Binding ShowAll}" RowDefinitions="Auto,*">

                    <Expander Grid.Row="0" Header="Фильтры" IsExpanded="False"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              Margin="8,4,8,4">
                        <DockPanel Margin="0,4,0,0">
                            <Button DockPanel.Dock="Right" Content="Сброс" Command="{Binding ResetFiltersCommand}"
                                    VerticalAlignment="Top" MinHeight="0" Height="26" Padding="8,2" Margin="4,0,0,0"/>
                            <views:ProjectFiltersWindow DataContext="{Binding ProjectFilters}"/>
                        </DockPanel>
                    </Expander>

                    <DataGrid x:Name="FullGrid" Grid.Row="1"
                              SelectionMode="Extended" SelectionChanged="OnGridSelectionChanged"
                              ItemsSource="{Binding FilteredFull}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True">
						<DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Изменить" Command="{Binding EditFullExhibitCommand}"/>
                                <MenuItem Header="Удалить" Command="{Binding DeleteFullExhibitsCommand}"/>
                                <Separator/>
                                <MenuItem Header="Добавить в группу НИР..." Command="{Binding AddToNirGroupCommand}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
							<DataGridTextColumn Header="Регистрационный номер" Binding="{Binding Regnumber}" />
							<DataGridTextColumn Header="Признак формы НИР" Binding="{Binding Type}" />
							<DataGridTextColumn Header="Наименование проекта" Binding="{Binding Subject}" />
							<DataGridTextColumn Header="Код ГРНТИ" Binding="{Binding Grnti}" />
							<DataGridTextColumn Header="Наименование рубрики" Binding="{Binding Rubrika}" />
							<DataGridTextColumn Header="Руководитель" Binding="{Binding Bossname}" />
							<DataGridTextColumn Header="Должность/научная степень руководителя" Binding="{Binding Bosstitle}" />
							<DataGridTextColumn Header="Наличие экспоната" Binding="{Binding Exhitype}" />
							<DataGridTextColumn Header="Выставки" Binding="{Binding Vystavki}" />
							<DataGridTextColumn Header="Название экспоната" Binding="{Binding Exponat}" />
							<DataGridTextColumn Header="Код ВУЗа" Binding="{Binding Codvuz}" />
							<DataGridTextColumn Header="Краткое наименование ВУЗа" Binding="{Binding Z2}" />
							<DataGridTextColumn Header="Наименование ВУЗа" Binding="{Binding Z1}" />
							<DataGridTextColumn Header="Полное наименование ВУЗа" Binding="{Binding Z1Full}" />
							<DataGridTextColumn Header="Тип учреждения" Binding="{Binding Status}" />
							<DataGridTextColumn Header="Федеральный округ" Binding="{Binding Region}" />
							<DataGridTextColumn Header="Город" Binding="{Binding City}" />
							<DataGridTextColumn Header="Код региона" Binding="{Binding Obl}" />
							<DataGridTextColumn Header="Регион" Binding="{Binding OblName}" />
							<DataGridTextColumn Header="Статус" Binding="{Binding GrVed}" />
							<DataGridTextColumn Header="Специализация" Binding="{Binding Prof}" />
						</DataGrid.Columns>
					</DataGrid>
				</Grid>
			
                <Grid x:Name="GroupsWorkspace" IsVisible="{Binding ShowNirGroups}" RowDefinitions="*" Margin="8">
                    <Grid.Styles>
                        <Style Selector="DataGrid.scroll-active">
                            <Setter Property="BorderBrush" Value="#48A9E6"/>
                            <Setter Property="BorderThickness" Value="2"/>
                        </Style>
                        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                            <Setter Property="Background" Value="#DDF0FC"/>
                            <Setter Property="BorderBrush" Value="#48A9E6"/>
                        </Style>
                        <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
                            <Setter Property="Background" Value="#B9DFF7"/>
                            <Setter Property="BorderBrush" Value="#3498DB"/>
                        </Style>
                        <Style Selector="TextBox"><Setter Property="SelectionBrush" Value="#48A9E6"/></Style>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                            <Setter Property="Background" Value="#C8E5FA"/>
                        </Style>
                        <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                            <Setter Property="Background" Value="#C8E5FA"/>
                        </Style>
                    </Grid.Styles>
                    <ScrollViewer x:Name="GroupDetailsScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" IsScrollChainingEnabled="True">
                    <StackPanel Spacing="8" Margin="0,0,8,0">
                    <Border Padding="0,0,0,8" Margin="0,0,0,6" BorderThickness="0,0,0,1" BorderBrush="#D6DCE2">
                        <views:NirGroupSelectorView x:Name="GroupSelector"/>
                    </Border>
                    <Grid x:Name="SelectedGroupHeader" ColumnDefinitions="*,Auto" IsVisible="{Binding HasSelectedNirGroup}" Margin="0,0,0,8">
                                    <Border Background="#F0F7FD" BorderBrush="#B7D8F1" BorderThickness="1" CornerRadius="4" Padding="12,10">
                                    <StackPanel Spacing="4">
                                        <Grid>
                                            <TextBlock Text="{Binding SelectedNirGroup.Code}" IsVisible="{Binding !IsEditingNirGroup}"
                                                       FontSize="20" FontWeight="SemiBold" MaxLines="1" TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding SelectedNirGroup.Code}"/>
                                            <TextBox Text="{Binding EditedNirGroupName, Mode=TwoWay}" IsVisible="{Binding IsEditingNirGroup}"
                                                     PlaceholderText="Название" FontSize="20" FontWeight="SemiBold"/>
                                        </Grid>
                                        <Grid>
                                            <StackPanel IsVisible="{Binding !IsEditingNirGroup}">
                                                <TextBlock Text="{Binding SelectedNirGroup.Comment}" IsVisible="{Binding HasNirGroupComment}"
                                                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" FontSize="13"
                                                           ToolTip.Tip="{Binding SelectedNirGroup.Comment}"/>
                                            </StackPanel>
                                            <TextBox x:Name="GroupCommentEditor" Text="{Binding EditedNirGroupComment, Mode=TwoWay}"
                                                     IsVisible="{Binding IsEditingNirGroup}" PlaceholderText="Комментарий" FontSize="13"
                                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="55" MaxHeight="100"/>
                                        </Grid>
                                        <StackPanel IsVisible="{Binding IsEditingNirGroup}" Orientation="Horizontal" Spacing="8"
                                                    HorizontalAlignment="Right" Margin="0,4,0,0">
                                            <Button Content="Сохранить" Command="{Binding SaveNirGroupCommand}"/>
                                            <Button Content="Отмена" Command="{Binding ResetNirGroupEditCommand}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Top" Margin="6,0,0,0">
                                    <Button Command="{Binding BeginNirGroupEditCommand}" IsEnabled="{Binding !IsEditingNirGroup}" VerticalAlignment="Top" Margin="0"
                                            Width="34" Height="34" Padding="8" ToolTip.Tip="Редактировать" AutomationProperties.Name="Редактировать группу">
                                            <PathIcon Width="14" Height="14" Data="M3,17.25 V21 H6.75 L17.81,9.94 L14.06,6.19 Z M20.71,7.04 C21.1,6.65 21.1,6.02 20.71,5.63 L18.37,3.29 C17.98,2.9 17.35,2.9 16.96,3.29 L15.13,5.12 L18.88,8.87 Z"/>
                                    </Button>
                                        <Button Command="{Binding DeleteNirGroupCommand}" Width="34" Height="34" Padding="8"
                                                ToolTip.Tip="Удалить группу" AutomationProperties.Name="Удалить группу">
                                            <PathIcon Width="15" Height="15" Data="F0 M9,3 H15 V5 H21 V7 H3 V5 H9 Z M5,9 H19 V20 C19,21.1 18.1,22 17,22 H7 C5.9,22 5,21.1 5,20 Z M9,11 V19 H11 V11 Z M13,11 V19 H15 V11 Z"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                        <Border IsVisible="{Binding HasSelectedNirGroup}">
                            <StackPanel Spacing="8">
                                <Expander Header="Информация" IsExpanded="True" HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding NirGroupRows.Count, StringFormat='Выставок: {0}'}"/>
                                            <TextBlock Text="{Binding GroupRubrics}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding GroupRegions}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding GroupDistricts}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding NirGroupMessage}" TextWrapping="Wrap"/>
                    <DataGrid x:Name="NirGroupsGrid" ItemsSource="{Binding NirGroupRows}" Height="{Binding #GroupDetailsScroll.Viewport.Height}"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.IsScrollChainingEnabled="False"
                              SelectionMode="Extended" SelectionChanged="OnGridSelectionChanged"
                              AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Убрать из группы" Command="{Binding RemoveFromNirGroupCommand}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
							<DataGridTextColumn Header="Регистрационный номер" Binding="{Binding Exhibit.Regnumber}" />
							<DataGridTextColumn Header="Признак формы НИР" Binding="{Binding Exhibit.Type}" />
							<DataGridTextColumn Header="Наименование проекта" Binding="{Binding Exhibit.Subject}" />
							<DataGridTextColumn Header="Код ГРНТИ" Binding="{Binding Exhibit.Grnti}" />
							<DataGridTextColumn Header="Наименование рубрики" Binding="{Binding Exhibit.Rubrika}" />
							<DataGridTextColumn Header="Руководитель" Binding="{Binding Exhibit.Bossname}" />
							<DataGridTextColumn Header="Должность/научная степень руководителя" Binding="{Binding Exhibit.Bosstitle}" />
							<DataGridTextColumn Header="Наличие экспоната" Binding="{Binding Exhibit.Exhitype}" />
							<DataGridTextColumn Header="Выставки" Binding="{Binding Exhibit.Vystavki}" />
							<DataGridTextColumn Header="Название экспоната" Binding="{Binding Exhibit.Exponat}" />
							<DataGridTextColumn Header="Код ВУЗа" Binding="{Binding Exhibit.Codvuz}" />
							<DataGridTextColumn Header="Краткое наименование ВУЗа" Binding="{Binding Exhibit.Z2}" />
							<DataGridTextColumn Header="Наименование ВУЗа" Binding="{Binding Exhibit.Z1}" />
							<DataGridTextColumn Header="Полное наименование ВУЗа" Binding="{Binding Exhibit.Z1Full}" />
							<DataGridTextColumn Header="Тип учреждения" Binding="{Binding Exhibit.Status}" />
							<DataGridTextColumn Header="Федеральный округ" Binding="{Binding Exhibit.Region}" />
							<DataGridTextColumn Header="Город" Binding="{Binding Exhibit.City}" />
							<DataGridTextColumn Header="Код региона" Binding="{Binding Exhibit.Obl}" />
							<DataGridTextColumn Header="Регион" Binding="{Binding Exhibit.OblName}" />
							<DataGridTextColumn Header="Статус" Binding="{Binding Exhibit.GrVed}" />
							<DataGridTextColumn Header="Специализация" Binding="{Binding Exhibit.Prof}" />
						</DataGrid.Columns>
                    </DataGrid>
                    </StackPanel>
                    </ScrollViewer>
                </Grid>
</Grid>

			<Grid IsVisible="{Binding ShowErrorScreen}" Margin="16">
				<DockPanel>
					<TextBlock DockPanel.Dock="Top"
                               Text="Загрузка завершилась со следующими предупреждениями:"
                               FontSize="16" FontWeight="SemiBold"
                               Margin="0,0,0,8" />

					<StackPanel DockPanel.Dock="Bottom"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="8" Margin="0,12,0,0">
						<Button Content="Перейти к таблицам"
                                Command="{Binding GoToTablesCommand}" />
					</StackPanel>

					<TextBox Text="{Binding ErrorScreenText}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             FontFamily="Consolas"
                             FontSize="12" />
				</DockPanel>
			</Grid>
		</Grid>
	</DockPanel>
</Window>

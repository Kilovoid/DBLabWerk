<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SQLWerk.ViewModels"
        x:Class="SQLWerk.Views.ConfirmWindow"
        x:DataType="vm:ConfirmViewModel"
        Width="400" Height="180"
        WindowStartupLocation="CenterOwner"
        Title="{Binding Title}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    Spacing="8" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Да"  Command="{Binding YesCommand}"/>
            <Button Content="Нет" Command="{Binding NoCommand}"/>
        </StackPanel>
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
    </DockPanel>
</Window>
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SQLWerk.ViewModels"
        x:Class="SQLWerk.Views.VuzEditWindow"
        x:DataType="vm:VuzEditViewModel"
        Width="560" Height="680"
        WindowStartupLocation="CenterOwner"
        Title="{Binding Title}">
    <ScrollViewer>
        <StackPanel Margin="16" Spacing="6">
            <TextBlock Text="Код ВУЗа *"/>
            <TextBox Text="{Binding Codvuz}"
                     IsReadOnly="{Binding IsEditMode}"/>

            <TextBlock Text="Наименование *"/>
            <TextBox Text="{Binding Z1}"/>

            <TextBlock Text="Полное наименование *"/>
            <TextBox Text="{Binding Z1Full}"/>

            <TextBlock Text="Краткое наименование *"/>
            <TextBox Text="{Binding Z2}"/>

            <TextBlock Text="Федеральный округ *"/>
            <ComboBox ItemsSource="{x:Static vm:VuzEditViewModel.RegionOptions}"
                      SelectedItem="{Binding Region}"
                      HorizontalAlignment="Stretch"/>

            <TextBlock Text="Город *"/>
            <TextBox Text="{Binding City}"/>

            <TextBlock Text="Тип учреждения *"/>
            <ComboBox ItemsSource="{x:Static vm:VuzEditViewModel.StatusOptions}"
                      SelectedItem="{Binding Status}"
                      HorizontalAlignment="Stretch"/>

            <TextBlock Text="Код региона *"/>
            <ComboBox ItemsSource="{x:Static vm:VuzEditViewModel.OblOptions}"
                      SelectedItem="{Binding Obl}"
                      HorizontalAlignment="Stretch"/>

            <TextBlock Text="Регион (заполняется автоматически)"/>
            <TextBox Text="{Binding OblName}" IsReadOnly="True"/>

            <TextBlock Text="Статус"/>
            <TextBox Text="{Binding GrVed}"/>

            <TextBlock Text="Специализация"/>
            <TextBox Text="{Binding Prof}"/>

            <TextBlock Text="{Binding Error}" Foreground="Red" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Сохранить" Command="{Binding SaveCommand}"/>
                <Button Content="Отмена"    Command="{Binding CancelCommand}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
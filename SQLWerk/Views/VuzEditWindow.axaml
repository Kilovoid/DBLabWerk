<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SQLWerk.ViewModels"
        x:Class="SQLWerk.Views.VuzEditWindow"
        x:DataType="vm:VuzEditViewModel"
        Width="560" Height="680"
        WindowStartupLocation="CenterOwner"
        Title="{Binding Title}">
    <ScrollViewer>
        <StackPanel Margin="16" Spacing="6">
            <TextBlock Text="Код ВУЗа *"/>
            <TextBox Text="{Binding Codvuz}"
                     IsReadOnly="{Binding IsEditMode}"/>

            <TextBlock Text="Наименование *"/>
            <TextBox Text="{Binding Z1}"/>

            <TextBlock Text="Полное наименование *"/>
            <TextBox Text="{Binding Z1Full}"/>

            <TextBlock Text="Краткое наименование *"/>
            <TextBox Text="{Binding Z2}"/>

            <TextBlock Text="Федеральный округ *"/>
            <AutoCompleteBox ItemsSource="{x:Static vm:VuzEditViewModel.RegionOptions}"
                             Text="{Binding Region, Mode=TwoWay}"
                             FilterMode="Contains" MinimumPrefixLength="1"
                             IsTextCompletionEnabled="False"
                             HorizontalAlignment="Stretch"/>

            <TextBlock Text="Город *"/>
            <AutoCompleteBox ItemsSource="{x:Static vm:VuzEditViewModel.CityOptions}"
                             Text="{Binding City, Mode=TwoWay}"
                             FilterMode="Contains" MinimumPrefixLength="1"
                             IsTextCompletionEnabled="False"
                             HorizontalAlignment="Stretch"/>

            <TextBlock Text="Тип учреждения *"/>
            <AutoCompleteBox ItemsSource="{x:Static vm:VuzEditViewModel.StatusOptions}"
                             Text="{Binding Status, Mode=TwoWay}"
                             FilterMode="Contains" MinimumPrefixLength="1"
                             IsTextCompletionEnabled="False"
                             HorizontalAlignment="Stretch"/>

            <TextBlock Text="Код региона *"/>
            <AutoCompleteBox ItemsSource="{x:Static vm:VuzEditViewModel.OblOptions}"
                             Text="{Binding Obl, Mode=TwoWay}"
                             FilterMode="Contains" MinimumPrefixLength="1"
                             IsTextCompletionEnabled="False"
                             HorizontalAlignment="Stretch"/>

            <TextBlock Text="Регион / область *"/>
            <AutoCompleteBox ItemsSource="{x:Static vm:VuzEditViewModel.OblNameOptions}"
                             Text="{Binding OblName, Mode=TwoWay}"
                             FilterMode="Contains" MinimumPrefixLength="1"
                             IsTextCompletionEnabled="False"
                             HorizontalAlignment="Stretch"/>

            <TextBlock Text="Статус"/>
            <AutoCompleteBox ItemsSource="{x:Static vm:VuzEditViewModel.GrVedOptions}"
                             Text="{Binding GrVed, Mode=TwoWay}"
                             FilterMode="Contains" MinimumPrefixLength="1"
                             IsTextCompletionEnabled="False"
                             HorizontalAlignment="Stretch"/>

            <TextBlock Text="Специализация"/>
            <AutoCompleteBox ItemsSource="{x:Static vm:VuzEditViewModel.ProfOptions}"
                             Text="{Binding Prof, Mode=TwoWay}"
                             FilterMode="Contains" MinimumPrefixLength="1"
                             IsTextCompletionEnabled="False"
                             HorizontalAlignment="Stretch"/>

            <TextBlock Text="{Binding Error}" Foreground="Red" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Сохранить" Command="{Binding SaveCommand}"/>
                <Button Content="Отмена"    Command="{Binding CancelCommand}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>

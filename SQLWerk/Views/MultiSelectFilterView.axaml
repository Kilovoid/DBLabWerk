<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SQLWerk.ViewModels" x:Class="SQLWerk.Views.MultiSelectFilterView"
             x:DataType="vm:MultiSelectFilterViewModel">
    <UserControl.Styles>
        <Style Selector="Button.filter">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#A3ADBA"/>
            <Setter Property="Background"><LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#FFFFFF"/><GradientStop Offset="1" Color="#E3E8EE"/>
            </LinearGradientBrush></Setter>
        </Style>
        <Style Selector="Button.filter.active"><Setter Property="BorderBrush" Value="#3078B8"/>
            <Setter Property="Foreground" Value="#14558B"/></Style>
        <Style Selector="CheckBox.value"><Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/><Setter Property="FontSize" Value="12"/></Style>
        <Style Selector="Button.popup"><Setter Property="MinHeight" Value="0"/>
            <Setter Property="Height" Value="26"/><Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="8,2"/></Style>
    </UserControl.Styles>
    <Button Classes="filter" Classes.active="{Binding IsActive}" HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch">
        <Button.Content><Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}"/>
            <TextBlock Grid.Column="1" Text="▾" Margin="6,0,0,0" FontSize="10" VerticalAlignment="Center"/>
        </Grid></Button.Content>
        <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedLeft" ShowMode="Standard" Opening="OnFilterOpening">
                <StackPanel Width="280" Spacing="5">
                    <TextBox Text="{Binding SearchText, Mode=TwoWay}" PlaceholderText="Поиск" FontSize="12"/>
                    <CheckBox Classes="value" Content="Все" IsThreeState="False" IsChecked="{Binding AllVisibleSelected, Mode=TwoWay}"/>
                    <ScrollViewer Height="210" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding VisibleValues}">
                            <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:FilterValueViewModel">
                                <CheckBox Classes="value" IsChecked="{Binding IsSelected, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontSize="12"/>
                                </CheckBox>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                        <Button Classes="popup" Content="ОК" Click="OnApply" MinWidth="60"/>
                        <Button Classes="popup" Content="Отмена" Click="OnCancel"/>
                    </StackPanel>
                </StackPanel>
            </Flyout>
        </Button.Flyout>
    </Button>
</UserControl>

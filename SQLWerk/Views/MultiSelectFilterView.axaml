<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SQLWerk.ViewModels"
             x:Class="SQLWerk.Views.MultiSelectFilterView"
             x:DataType="vm:MultiSelectFilterViewModel">
    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
            Height="60" Padding="10,6">
        <Button.Content>
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}"/>
                    <TextBlock Text="{Binding Summary}" FontSize="11"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Summary}"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="▾" Margin="8,0,0,0"
                           VerticalAlignment="Center"/>
            </Grid>
        </Button.Content>
        <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedLeft" ShowMode="Standard"
                    Opening="OnFilterOpening">
                <StackPanel Spacing="6" Width="280">
                    <TextBox Text="{Binding SearchText, Mode=TwoWay}"
                             PlaceholderText="Поиск по подстроке..."/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="Отметить все" Command="{Binding SelectAllCommand}"/>
                        <Button Content="Снять все" Command="{Binding ClearAllCommand}"/>
                    </StackPanel>
                    <ScrollViewer Height="180" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding VisibleValues}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FilterValueViewModel">
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch">
                                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap"/>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Flyout>
        </Button.Flyout>
    </Button>
</UserControl>

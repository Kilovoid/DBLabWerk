<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SQLWerk.ViewModels"
             x:Class="SQLWerk.Views.MultiSelectFilterView"
             x:DataType="vm:MultiSelectFilterViewModel">
    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
        <Expander.Header>
            <StackPanel Spacing="2">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                           MaxWidth="160" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}"/>
                <TextBlock Text="{Binding Summary}" FontSize="11"
                           MaxWidth="160" TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding Summary}"/>
            </StackPanel>
        </Expander.Header>
        <StackPanel Spacing="6" Margin="8">
            <TextBox Text="{Binding SearchText, Mode=TwoWay}"
                     PlaceholderText="Поиск по подстроке..."/>
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Content="Отметить найденные" Command="{Binding SelectVisibleCommand}"
                        FontSize="11" Padding="5"/>
                <Button Content="Снять" Command="{Binding ClearVisibleCommand}"
                        FontSize="11" Padding="5"
                        ToolTip.Tip="Снять галочки только с найденных значений"/>
            </StackPanel>
            <Button Content="Оставить только найденные"
                    Command="{Binding SelectOnlyVisibleCommand}" FontSize="11"/>
            <ScrollViewer Height="150" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding VisibleValues}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FilterValueViewModel">
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch">
                                <TextBlock Text="{Binding Label}" TextWrapping="Wrap"/>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Button Content="Сбросить этот фильтр" Command="{Binding ResetCommand}"/>
        </StackPanel>
    </Expander>
</UserControl>

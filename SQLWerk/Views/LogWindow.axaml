<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SQLWerk.ViewModels"
        x:Class="SQLWerk.Views.LogWindow"
        x:DataType="vm:LogViewModel"
        Width="900" Height="520"
        Title="Журнал">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="8">
            <Button Content="Очистить" Command="{Binding ClearCommand}"/>
            <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>
        <DataGrid ItemsSource="{Binding Entries}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Время"
                    Binding="{Binding Time, StringFormat='{}{0:HH:mm:ss}'}" Width="90"/>
                <DataGridTextColumn Header="Уровень" Binding="{Binding Level}" Width="90"/>
                <DataGridTextColumn Header="Файл" Binding="{Binding File}" Width="180"/>
                <DataGridTextColumn Header="Строка" Binding="{Binding Row}" Width="70"/>
                <DataGridTextColumn Header="Причина" Binding="{Binding Reason}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
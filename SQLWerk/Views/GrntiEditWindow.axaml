<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SQLWerk.ViewModels"
        x:Class="SQLWerk.Views.GrntiEditWindow"
        x:DataType="vm:GrntiEditViewModel"
        Width="420" Height="260"
        WindowStartupLocation="CenterOwner"
        Title="{Binding Title}">
    <StackPanel Margin="16" Spacing="8">
        <TextBlock Text="Код рубрики * (2 цифры)"/>
        <TextBox Text="{Binding Codrub}"
                 IsReadOnly="{Binding IsEditMode}"
                 MaxLength="2"
                 Watermark="например: 02"/>

        <TextBlock Text="Наименование рубрики *"/>
        <TextBox Text="{Binding Rubrika}"/>

        <TextBlock Text="{Binding Error}" Foreground="Red" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" Spacing="8"
                    HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Сохранить" Command="{Binding SaveCommand}"/>
            <Button Content="Отмена"    Command="{Binding CancelCommand}"/>
        </StackPanel>
    </StackPanel>
</Window>
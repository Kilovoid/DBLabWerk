<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SQLWerk.Views.NewNirGroupWindow"
        Title="Новая группа НИР" Width="440" Height="330"
        CanResize="False" WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="16">
        <TextBlock Grid.Row="0" Text="Название группы:"
                   TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TextBox x:Name="GroupNameInput" Grid.Row="1"/>
        <TextBlock Grid.Row="2" Text="Комментарий:" Margin="0,8,0,4"/>
        <TextBox x:Name="GroupCommentInput" Grid.Row="3" AcceptsReturn="True" TextWrapping="Wrap" Height="60"/>
        <TextBlock x:Name="ValidationMessage" Grid.Row="4" Foreground="Firebrick"
                   TextWrapping="Wrap" Margin="0,8,0,8"/>
        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8"
                    HorizontalAlignment="Right">
            <Button Content="ОК" IsDefault="True" Click="OnOkClick"/>
            <Button Content="Отмена" IsCancel="True" Click="OnCancelClick"/>
        </StackPanel>
    </Grid>
</Window>

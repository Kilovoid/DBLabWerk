<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SQLWerk.ViewModels"
        x:Class="SQLWerk.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1500" Height="850"
        Title="Выставки МО">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top"
            Orientation="Horizontal"
            Spacing="8"
            Margin="8">
        <Button Content="Exhibits"
            Command="{Binding SelectExhibitsCommand}" />
        <Button Content="Vuz"
            Command="{Binding SelectVuzCommand}" />
        <Button Content="Grnti"
            Command="{Binding SelectGrntiCommand}" />

        <TextBlock Text="{Binding Status}"
               VerticalAlignment="Center"
               Margin="16,0,0,0" />
        </StackPanel>

        <Grid>
            <DataGrid ItemsSource="{Binding Exhibits}"
                      IsVisible="{Binding ShowExhibits}"
                      AutoGenerateColumns="True" />
            <DataGrid ItemsSource="{Binding Vuzes}"
                      IsVisible="{Binding ShowVuz}"
                      AutoGenerateColumns="True" />
            <DataGrid ItemsSource="{Binding Grnti}"
                      IsVisible="{Binding ShowGrnti}"
                      AutoGenerateColumns="True" />
        </Grid>

    </DockPanel>
</Window>

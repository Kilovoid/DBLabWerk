        {
            ShowExhibits = false;
            ShowVuz = true;
            ShowGrnti = false;

            RowCount = Vuzes.Count;
            Status = $"Vuz: {RowCount} rows";
        }

        [RelayCommand]
        public void SelectGrnti()
        {
            ShowExhibits = false;
            ShowVuz = false;
            ShowGrnti = true;

            RowCount = Grnti.Count;
            Status = $"Grnti: {RowCount} rows";
        }
    }



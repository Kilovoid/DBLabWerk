<file path="SQLWerk/Data/Sqlite/NirGroupRepository.cs">
using SQLWerk.Data.Abstractions;
using SQLWerk.Models;
using System;
using System.Collections.Generic;
using System.Linq;

namespace SQLWerk.Data.Sqlite;

internal sealed class NirGroupRepository : INirGroupRepository
{
    private readonly IConnectionFactory _factory;
    public NirGroupRepository(IConnectionFactory factory) => _factory = factory;

    public void EnsureCreated()
    {
        using var connection = _factory.Create();
        connection.Open();
        using var command = connection.CreateCommand();
        command.CommandText = """
            CREATE TABLE IF NOT EXISTS NirGroups (
                Id INTEGER PRIMARY KEY AUTOINCREMENT,
                Name TEXT NOT NULL COLLATE NOCASE UNIQUE CHECK(length(trim(Name)) > 0)
            );
            CREATE TABLE IF NOT EXISTS NirGroupMembers (
                GroupId INTEGER NOT NULL,
                ExhibitId INTEGER NOT NULL,
                PRIMARY KEY (GroupId, ExhibitId),
                FOREIGN KEY (GroupId) REFERENCES NirGroups(Id) ON DELETE CASCADE,
                FOREIGN KEY (ExhibitId) REFERENCES Exhibits(Id) ON DELETE CASCADE
            );
            CREATE INDEX IF NOT EXISTS IX_NirGroupMembers_ExhibitId ON NirGroupMembers(ExhibitId);
            """;
        command.ExecuteNonQuery();
    }

    public List<NirGroup> GetGroups()
    {
        using var connection = _factory.Create();
        connection.Open();
        using var command = connection.CreateCommand();
        command.CommandText = "SELECT Id, Name FROM NirGroups ORDER BY Name, Id;";
        using var reader = command.ExecuteReader();
        var groups = new List<NirGroup>();
        while (reader.Read())
            groups.Add(new NirGroup { Id = reader.GetInt64(0), Name = reader.GetString(1) });
        return groups;
    }

    public long CreateGroup(string name)
    {
        name = name.Trim();
        if (name.Length == 0) throw new ArgumentException("Введите название группы.");
        using var connection = _factory.Create();
        connection.Open();
        using var command = connection.CreateCommand();
        command.CommandText = "INSERT INTO NirGroups(Name) VALUES ($name); SELECT last_insert_rowid();";
        command.Parameters.AddWithValue("$name", name);
        return Convert.ToInt64(command.ExecuteScalar());
    }

    public List<long> GetExhibitIds(long groupId)
    {
        using var connection = _factory.Create();
        connection.Open();
        using var command = connection.CreateCommand();
        command.CommandText = "SELECT ExhibitId FROM NirGroupMembers WHERE GroupId=$group ORDER BY ExhibitId;";
        command.Parameters.AddWithValue("$group", groupId);
        using var reader = command.ExecuteReader();
        var ids = new List<long>();
        while (reader.Read()) ids.Add(reader.GetInt64(0));
        return ids;
    }

    public int AddMembers(long groupId, IEnumerable<long> exhibitIds) =>
        ChangeMembers(groupId, exhibitIds, true);

    public int RemoveMembers(long groupId, IEnumerable<long> exhibitIds) =>
        ChangeMembers(groupId, exhibitIds, false);

    private int ChangeMembers(long groupId, IEnumerable<long> ids, bool add)
    {
        using var connection = _factory.Create();
        connection.Open();
        using var transaction = connection.BeginTransaction();
        using var command = connection.CreateCommand();
        command.Transaction = transaction;
        command.CommandText = add
            ? "INSERT INTO NirGroupMembers(GroupId,ExhibitId) VALUES ($group,$exhibit) ON CONFLICT(GroupId,ExhibitId) DO NOTHING;"
            : "DELETE FROM NirGroupMembers WHERE GroupId=$group AND ExhibitId=$exhibit;";
        command.Parameters.AddWithValue("$group", groupId);
        var parameter = command.Parameters.Add("$exhibit", Microsoft.Data.Sqlite.SqliteType.Integer);
        int changed = 0;
        foreach (var id in ids.Distinct())
        {
            parameter.Value = id;
            changed += command.ExecuteNonQuery();
        }
        transaction.Commit();
        return changed;
    }
}

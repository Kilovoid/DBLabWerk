            await AddExhibitsToGroupAsync(ids);
        }

        private async Task AddExhibitsToGroupAsync(long[] ids)
        {
            if (ids.Length == 0 || SelectNirGroupHandler is null) return;
            try
            {
                var group = await SelectNirGroupHandler();
                if (group is null) return;
                int added = _nirGroupRepo.AddMembers(group.Id, ids);
                ReloadNirGroups(group.Id);
                Status = NirGroupMessage = $"В группу «{group.Name}» добавлено: {added}. Уже были в группе: {ids.Length - added}.";
            }
            catch (Exception ex) { Status = NirGroupMessage = "Ошибка добавления: " + ex.Message; }
        }

        [RelayCommand(CanExecute = nameof(CanEditFullExhibit))]
        private async Task EditFullExhibit()
        {
            if (!CanEditFullExhibit()) return;
            var row = Exhibits.FirstOrDefault(item => item.Id == SelectedFullRows[0].Id);
            if (row is null) return;
            SelectedExhibits = new() { row };
            await EditExhibitAsync();
            var status = Status;
            SelectFull();
            Status = status;
        }

        [RelayCommand(CanExecute = nameof(CanDeleteFullExhibits))]
        private async Task DeleteFullExhibits()
        {
            if (!CanDeleteFullExhibits()) return;
            var ids = SelectedFullRows.Select(row => row.Id).ToHashSet();
            SelectedExhibits = Exhibits.Where(row => ids.Contains(row.Id)).ToList();
            await DeleteExhibitAsync();
            var status = Status;
            SelectFull();
            Status = status;
        }

        [RelayCommand(CanExecute = nameof(CanRemoveFromNirGroup))]
        private void RemoveFromNirGroup()
        {
            if (!CanRemoveFromNirGroup()) return;
            var selected = SelectedGroupRows.ToArray();
            try
            {
                int removed = 0;
                foreach (var group in selected.GroupBy(row => row.GroupId))
                    removed += _nirGroupRepo.RemoveMembers(group.Key,
                        group.Select(row => row.Exhibit.Id).Distinct().ToArray());
                RefreshNirGroup();
                Status = NirGroupMessage = $"Из групп исключено: {removed}. Сами НИР сохранены.";
            }
            catch (Exception ex) { RefreshNirGroup(); NirGroupMessage = "Ошибка исключения: " + ex.Message; }
        }

        private void ReloadNirGroups(long? preferredId = null)
        {
            var id = preferredId ?? SelectedNirGroup?.Id;
            _nirGroupRepo.EnsureCreated();
            NirGroups = new ObservableCollection<NirGroup>(_nirGroupRepo.GetGroups());
            SelectedNirGroup = NirGroups.FirstOrDefault(group => group.Id == id) ?? NirGroups.FirstOrDefault();
            RefreshNirGroup();
        }

        private void RefreshNirGroup()
        {
            SelectedGroupRows = new();
            var exhibits = FullTable.DistinctBy(row => row.Id).ToDictionary(row => row.Id);
            var rows = new List<NirGroupEntry>();
            foreach (var group in NirGroups)
                foreach (var id in _nirGroupRepo.GetExhibitIds(group.Id))
                    if (exhibits.TryGetValue(id, out var exhibit))
                        rows.Add(new NirGroupEntry { GroupId = group.Id, GroupName = group.Name, Exhibit = exhibit });
            NirGroupRows = new ObservableCollection<NirGroupEntry>(rows);
        }


        [RelayCommand]
        private void CreateNirGroup()
        {
            var name = (NewNirGroupName ?? "").Trim();
            if (name.Length == 0) { NirGroupMessage = "Введите название группы."; return; }
            if (NirGroups.Any(group => string.Equals(group.Name, name, StringComparison.OrdinalIgnoreCase)))
            { NirGroupMessage = "Группа с таким названием уже существует."; return; }
            try
            {
                var id = _nirGroupRepo.CreateGroup(name);
                ReloadNirGroups(id);
                NewNirGroupName = "";
                NirGroupMessage = "Группа создана и сохранена в БД.";
            }
            catch (Exception ex) { NirGroupMessage = "Ошибка создания группы: " + ex.Message; }
        }

        [RelayCommand(CanExecute = nameof(CanAddToNirGroup))]
        private async Task AddToNirGroup()
        {

using Avalonia;
using Avalonia.Controls;
using Avalonia.Layout;
using SQLWerk.Models;
using SQLWerk.ViewModels;
using System.Linq;

namespace SQLWerk.Views;

// Простое модальное окно без нового сервиса и регистрации в DI.
public sealed class NirGroupPickerWindow : Window
{
    public NirGroupPickerWindow(MainWindowViewModel vm)
    {
        Title = "Добавить выбранные выставки в группу НИР";
        Width = 500;
        Height = 310;
        CanResize = false;
        WindowStartupLocation = WindowStartupLocation.CenterOwner;

        var groups = new ComboBox { HorizontalAlignment = HorizontalAlignment.Stretch };
        var name = new TextBox();
        var message = new TextBlock { TextWrapping = Avalonia.Media.TextWrapping.Wrap };
        var create = new Button { Content = "Создать группу" };
        var add = new Button { Content = "Добавить", IsDefault = true };
        var cancel = new Button { Content = "Отмена", IsCancel = true };

        void RefreshGroups()
        {
            var items = vm.NirGroups.Select(group => new ComboBoxItem
            {
                Content = $"{group.Id}: {group.Name}", Tag = group
            }).ToList();
            groups.ItemsSource = items;
            groups.SelectedItem = items.FirstOrDefault(item =>
                item.Tag is NirGroup group && group.Id == vm.SelectedNirGroup?.Id)
                ?? items.FirstOrDefault();
            add.IsEnabled = groups.SelectedItem != null;
        }

        groups.SelectionChanged += (_, _) => add.IsEnabled = groups.SelectedItem != null;
        create.Click += (_, _) =>
        {
            vm.NewNirGroupName = name.Text ?? "";
            vm.CreateNirGroupCommand.Execute(null);
            RefreshGroups();
            name.Text = vm.NewNirGroupName;
            message.Text = vm.NirGroupMessage;
        };
        add.Click += (_, _) =>
        {
            if (groups.SelectedItem is ComboBoxItem { Tag: NirGroup group })
                Close(group);
        };
        cancel.Click += (_, _) => Close();
        RefreshGroups();
        if (vm.NirGroups.Count == 0)
            message.Text = "Групп пока нет. Введите название и создайте группу.";

        Content = new StackPanel
        {
            Margin = new Thickness(16), Spacing = 10,
            Children =
            {
                new TextBlock { Text = "Группа для всех выбранных выставок:" },
                groups, new TextBlock { Text = "Создать новую группу:" }, name, create, message,
                new StackPanel
                {
                    Orientation = Orientation.Horizontal,
                    HorizontalAlignment = HorizontalAlignment.Right,
                    Spacing = 8, Children = { add, cancel }
                }
            }
        };
    }
}

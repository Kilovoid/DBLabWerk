        [ObservableProperty]
        private ObservableCollection<ExhibitTableRow> _exhibits = new();

        [ObservableProperty]
        private ObservableCollection<VuzTableRow> _vuzes = new();

        [ObservableProperty]
        private ObservableCollection<GrntiTableRow> _grnti = new();

